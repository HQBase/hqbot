{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hqbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "hqbot-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HQBOT_AGENT", "class_name": "HQBotAgent" }]
  },
  "workflows": [
    {
      "binding": "HQBOT_WORKFLOW",
      "name": "hqbot-task",
      "class_name": "HQBotWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HQBotAgent"]
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "HQBOT_ID": "hqbot",
    "HQBOT_MODEL_ID": "@cf/deepseek-ai/deepseek-v4-flash-0731",
    "HQBOT_AUTO_REPLY": "true"
  },
  "secrets": {
    "required": [
      "HQBOT_OWNER_TOKEN",
      "HQBASE_AGENT_TOKEN",
      "HQBASE_ORIGIN",
      "HQBASE_MAILBOX_ID",
      "HQBASE_MAILBOX_ADDRESS",
      "HQBOT_ALLOWED_SENDERS"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "limits": { "cpu_ms": 30000, "subrequests": 100 }
}
