{
  "name": "hqbot",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI teammates on customer-owned Cloudflare infrastructure.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "code:check": "biome check .",
    "cf:typegen": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types",
    "deploy": "pnpm build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "deploy:dry-run": "pnpm build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run",
    "check": "pnpm code:check && pnpm test && pnpm typecheck && pnpm deploy:dry-run",
    "hqbot": "node scripts/install.mjs"
  },
  "cloudflare": {
    "bindings": {
      "AI": {
        "description": "Workers AI plans and writes each Bot task."
      },
      "BROWSER": {
        "description": "Browser Run gives each task a real cloud browser."
      },
      "ARTIFACTS": {
        "description": "R2 stores browser screenshots and reviewable task artifacts."
      },
      "HQBOT_AGENT": {
        "description": "A Durable Object stores teammate profiles, connections, chats, tasks, and activity."
      },
      "HQBOT_WORKFLOW": {
        "description": "A Workflow runs durable research and reply tasks."
      },
      "ASSETS": {
        "description": "Worker Static Assets serves the HQBot web app."
      }
    }
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.88",
    "@cloudflare/ai-chat": "0.11.0",
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/shell": "0.4.3",
    "@cloudflare/think": "0.17.0",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-progress": "1.1.12",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.7",
    "agents": "0.22.0",
    "ai": "7.0.85",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sonner": "2.0.6",
    "tailwind-merge": "3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260830.1",
    "@shadcn/helpers": "0.2.0",
    "@types/node": "26.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.4.21",
    "happy-dom": "20.10.6",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
