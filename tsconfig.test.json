{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/workspace/local-devices.ts",
    "src/workspace/team-auth.ts",
    "src/workspace/team.ts",
    "src/workspace/templates.ts",
    "src/workspace/messages.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/domain/**/*.ts",
    "src/services/**/*.ts",
    "src/runtime/**/*.ts",
    "src/workspace/automations.ts",
    "src/workspace/auth.ts",
    "src/workspace/budgets.ts",
    "src/workspace/catalog.ts",
    "src/workspace/mail-realtime.ts",
    "src/workspace/migrations.ts",
    "src/workspace/product-migrations.ts",
    "src/workspace/knowledge.ts",
    "src/workspace/projects.ts",
    "src/workspace/collaboration.ts",
    "src/workspace/routines.ts",
    "src/workspace/events.ts",
    "src/workspace/push.ts",
    "src/workspace/demonstrations.ts",
    "src/workspace/model-budget.ts",
    "src/workspace/notifications.ts",
    "src/workspace/platform-footprint.ts",
    "src/workspace/sql.ts",
    "src/workspace/snapshot.ts",
    "src/workspace/tasks.ts",
    "test/env.d.ts"
  ]
}
