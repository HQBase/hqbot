{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/domain/**/*.ts",
    "src/services/crypto.ts",
    "src/services/mail.ts",
    "src/runtime/**/*.ts",
    "src/workspace/auth.ts",
    "src/workspace/budgets.ts",
    "src/workspace/catalog.ts",
    "src/workspace/migrations.ts",
    "src/workspace/sql.ts",
    "src/workspace/snapshot.ts",
    "src/workspace/tasks.ts",
    "test/env.d.ts"
  ]
}
