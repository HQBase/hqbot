{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/domain/local-devices.ts",
    "src/domain/admin-policy.ts",
    "src/domain/team.ts",
    "src/domain/templates.ts",
    "src/domain/messages.ts",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/domain/models.ts",
    "src/domain/actions.ts",
    "src/domain/knowledge.ts",
    "src/domain/permissions.ts",
    "src/domain/projects.ts",
    "src/domain/automations.ts",
    "src/domain/events.ts",
    "src/domain/push.ts",
    "src/domain/demonstrations.ts",
    "src/domain/skills.ts",
    "src/domain/types.ts",
    "src/domain/team-work.ts",
    "src/domain/team-policy.ts"
  ]
}
